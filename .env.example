# Cuidopê — variáveis de ambiente (SEM valores reais; nunca versionar .env)
CUIDOPE_ENV=development            # development | staging | production (production é recusado até B-001)
PORT=3333
# Segredo do webhook do PSP SANDBOX (mínimo 16 caracteres). Em produção cada PSP terá o seu, no cofre do servidor.
SANDBOX_WEBHOOK_SECRET=troque-este-valor-local-0000
# Futuro (backlog B-001): DATABASE_URL=postgres://...   (papel de aplicação, sem superusuário)
# Futuro: chaves do PSP, verificador de identidade, e-mail transacional — somente server-side, nunca NEXT_PUBLIC_*
