# Cuidopê — variáveis do front-end (Vite). Copie para .env.local e preencha.
# ATENÇÃO: tudo que começa com VITE_ vai para o bundle público do navegador.
# Nunca coloque aqui service_role, tokens da Meta/WhatsApp ou qualquer segredo.

# Backend de dados: demo | supabase | firebase
VITE_DATA_BACKEND=demo

# ---------- Supabase ----------
# URL do projeto (local: http://127.0.0.1:54321 após `supabase start`)
VITE_SUPABASE_URL=
# Chave publishable/anon (pública por design; a segurança vem da RLS). NUNCA a service_role.
VITE_SUPABASE_ANON_KEY=

# ---------- Firebase ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# true = conecta nos emuladores locais (auth :9099, firestore :8080)
VITE_FIREBASE_USE_EMULATOR=false

# ---------- Login de demonstração ----------
# Só habilite em ambientes de DEMO. Os usuários ana.demo@cuidope.app / carla.demo@cuidope.app
# existem apenas no seed local (supabase/seed.sql) ou se você criá-los no Firebase Auth.
VITE_DEMO_LOGIN=false
VITE_DEMO_PASSWORD=
