{
  "name": "cuidope-web",
  "private": true,
  "version": "1.0.0",
  "description": "Cuidopê — marketplace de cuidado pet (site + app PWA): busca pública, avaliações, agendamento, CRM WhatsApp e pacotes",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "test:e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@supabase/supabase-js": "2.118.0",
    "firebase": "13.2.0",
    "gsap": "3.15.1",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
