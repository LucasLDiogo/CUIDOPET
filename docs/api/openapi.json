    "/webhooks/{provider}": {
      "post": {
        "operationId": "receiveWebhook",
        "description": "Valida assinatura HMAC, persiste (deduplicado) e processa na sequência. Responde após persistência durável.",
        "parameters": [
          {
            "name": "provider",
