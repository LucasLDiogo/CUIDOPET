{
  "name": "cuidope",
  "private": true,
  "version": "0.1.0",
  "description": "Cuidopê — marketplace de cuidado pet + SaaS para prestadores (monólito modular)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "npm run test:domain && npm run test:contracts && npm run test:providers && npm run test:db && npm run test:api",
    "test:domain": "node --test \"packages/domain/test/*.test.ts\"",
    "test:contracts": "node --test \"packages/contracts/test/*.test.ts\"",
    "test:providers": "node --test \"packages/providers/test/*.test.ts\"",
    "test:db": "node --test --test-concurrency=1 \"database/tests/*.test.ts\"",
    "test:api": "node --test --test-concurrency=1 \"apps/api/test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "openapi": "node scripts/generate-openapi.ts",
    "dev": "node apps/api/src/server.ts",
    "smoke": "node scripts/smoke.ts",
    "qas": "node scripts/qas.ts",
    "backlog": "node scripts/generate-backlog.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  }
}
