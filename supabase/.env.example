# Segredos das Edge Functions (NUNCA no front-end).
# Local:   cp supabase/.env.example supabase/.env  →  supabase functions serve --env-file supabase/.env
# Produção: supabase secrets set --env-file supabase/.env   (ou um a um: supabase secrets set WA_TOKEN=...)
#
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY são injetadas automaticamente pela plataforma.

# Origens autorizadas a chamar whatsapp-send pelo navegador (separadas por vírgula, sem barra final)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- WhatsApp Cloud API (Meta) ----------
# App Secret do app na Meta — valida X-Hub-Signature-256 do webhook
WA_APP_SECRET=
# Token que você escolhe e cadastra no painel da Meta ao configurar o webhook (GET hub.verify_token)
WA_VERIFY_TOKEN=
# Token de acesso permanente (System User) com whatsapp_business_messaging
WA_TOKEN=
# ID do número de telefone padrão (pode ser sobrescrito por provider_settings.wa_phone_number_id)
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v21.0

# true = não chama a Meta; grava a mensagem como enviada com id "dryrun.*" (padrão quando WA_TOKEN está vazio)
WA_DRY_RUN=true
# limite simples de envios por prestador por minuto
WA_RATE_LIMIT_PER_MIN=20
